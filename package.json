{
  "name": "nav-hoard",
  "version": "0.1.0",
  "private": true,
  "description": "积径 - 个人网址导航页",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run build:types && tsc && vite build && pnpm run build:cli",
    "build:types": "pnpm --filter @nav-hoard/types run build",
    "build:cli": "pnpm --filter navhoard-cli run build",
    "preview": "vite preview",
    "navhoard-cli": "pnpm --filter navhoard-cli run cli",
    "navhoard-cli:build": "pnpm --filter navhoard-cli run build",
    "entry-workflow": "pnpm --filter navhoard-cli run entry",
    "entries-remove": "node tools/navhoard-cli/dist/entries-remove.js",
    "import:raindrop": "pnpm --filter navhoard-cli run import:raindrop",
    "edit": "pnpm --filter navhoard-cli run edit"
  },
  "dependencies": {
    "@nav-hoard/types": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.2.7",
    "@fontsource/fusion-pixel-12px-monospaced-sc": "^5.2.5",
    "lit": "^3.2.0",
    "minisearch": "^6.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
