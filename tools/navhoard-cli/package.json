{
  "name": "navhoard-cli",
  "version": "0.1.0",
  "description": "Nav Hoard data update CLI",
  "type": "module",
  "bin": {
    "navhoard-cli": "./dist/cli.js",
    "nav-hoard-entry-workflow": "./dist/entry-workflow.js",
    "navhoard-editor": "./dist/editor.js",
    "navhoard-import-raindrop": "./dist/import-raindrop.js"
  },
  "scripts": {
    "build": "tsc",
    "cli": "node dist/cli.js",
    "cli:dev": "tsx src/cli.ts",
    "entry": "node dist/entry-workflow.js",
    "entry:dev": "tsx src/entry-workflow.ts",
    "import:raindrop": "tsx src/import-raindrop.ts",
    "lint": "echo '暂未配置'",
    "edit": "tsx watch src/editor.ts",
    "edit:dev": "tsx watch src/editor.ts"
  },
  "dependencies": {
    "@nav-hoard/types": "workspace:*",
    "commander": "^12.1.0",
    "yaml": "^2.4.0",
    "rss-parser": "^3.13.0",
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "^3.3.2",
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/cheerio": "^0.22.31",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
